{
  "name": "@cloudlane/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "build:preview": "vite build --mode preview"
  },
  "dependencies": {
    "@cloudlane/contracts": "0.1.0",
    "@fontsource/inter": "5.2.8",
