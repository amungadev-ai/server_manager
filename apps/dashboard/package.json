  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.3.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.8",
    "vite": "8.3.8"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
