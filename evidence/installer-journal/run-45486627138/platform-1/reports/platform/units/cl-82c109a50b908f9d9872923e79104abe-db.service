[Unit]
Description=Cloudlane isolated review db
Requires=docker.service
After=docker.service
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
ExecStart=/usr/bin/docker --host=unix:///var/run/docker.sock --config=/etc/cloudlane/docker-client start --attach cl-82c109a50b908f9d9872923e79104abe-db
ExecStop=/usr/bin/docker --host=unix:///var/run/docker.sock --config=/etc/cloudlane/docker-client stop --time=30 cl-82c109a50b908f9d9872923e79104abe-db
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
