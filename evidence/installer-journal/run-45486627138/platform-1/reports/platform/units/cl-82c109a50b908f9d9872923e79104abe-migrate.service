[Unit]
Description=Cloudlane isolated review migrate
Requires=docker.service cl-82c109a50b908f9d9872923e79104abe-db.service
After=docker.service cl-82c109a50b908f9d9872923e79104abe-db.service
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker --host=unix:///var/run/docker.sock --config=/etc/cloudlane/docker-client start --attach cl-82c109a50b908f9d9872923e79104abe-migrate
ExecStop=/usr/bin/docker --host=unix:///var/run/docker.sock --config=/etc/cloudlane/docker-client stop --time=30 cl-82c109a50b908f9d9872923e79104abe-migrate
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
